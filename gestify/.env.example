# ---------------------------------------------------------------
# Copiá este archivo (.env.example) a .env (local) y cargá las mismas variables en
# Vercel > Settings > Environment Variables. NUNCA subas .env a GitHub.
# ---------------------------------------------------------------

# --- Supabase (Project Settings > API) ---
# Van al navegador: solo la URL y la clave pública (anon / publishable).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=
# Solo servidor. Esta clave se SALTEA todas las políticas RLS: jamás con prefijo VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- URL pública de la app (sin barra final) ---
# Se usa para los back_urls y notification_url de Mercado Pago.
# Local: http://localhost:3000 (Mercado Pago no puede avisar a localhost: probá webhooks ya desplegado o con un túnel).
APP_URL=https://TU-DOMINIO.vercel.app

# --- Mercado Pago de la PLATAFORMA (cobra el abono mensual de los comercios) ---
PLATFORM_MP_ACCESS_TOKEN=
# "Clave secreta" de Webhooks de tu aplicación de Mercado Pago (Tus integraciones > Webhooks).
# Se usa para validar la firma de /api/mp-suscripciones.
MP_WEBHOOK_SECRET=
# false (default): una firma inválida solo se registra en los logs. true: se rechaza con 401.
# Pasalo a true después de comprobar en los logs de Vercel que los avisos reales llegan con firma válida.
MP_WEBHOOK_STRICT=false

# --- Tareas programadas ---
# Cadena larga y aleatoria. Quien llame a /api/cron-reminders debe enviar: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# --- Seguridad del super admin ---
# true = el super admin necesita haber verificado TOTP (aal2) para operar. Dejalo en false hasta tener
# el TOTP configurado en tu cuenta (paso 3 de la migración).
REQUIRE_ADMIN_MFA=false
